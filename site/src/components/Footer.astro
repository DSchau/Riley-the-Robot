---
// The site footer: a quiet night on Riley's planet. Riley sits by a campfire
// on a dune and watches the stars. Everything moves slowly, and only while
// the footer is on screen.
//
// The "Read the book" buttons rely on <Reader />, which listens for
// [data-open-book] anywhere on the page.
import Icon from './Icon.astro';

// Deterministic, so builds are stable.
let seed = 23;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const n = (v: number) => v.toFixed(1);

// The sky is drawn as a 1600x600 tile, twice, side by side. Each layer slides
// left by one tile and loops, so the stars drift past without a seam.
const TILE = 1600;
const SKY_H = 600;
const TINTS = ['#fff', '#fff', '#fff', '#d6e8ff', '#ffe6cc'];

const starfield = (count: number, min: number, max: number, twinkling: number) =>
  Array.from({ length: count }, () => ({
    x: 3 + rand() * (TILE - 6),
    y: rand() ** 1.35 * 520, // denser toward the top of the sky
    r: min + rand() ** 2 * (max - min),
    fill: TINTS[Math.floor(rand() * TINTS.length)],
    twinkle: rand() < twinkling,
    d: rand() * 7,
    t: 3.5 + rand() * 5,
  }));
const farStars = starfield(95, 0.45, 1, 0.3);
const nearStars = starfield(40, 0.85, 1.9, 0.6);

// A spiral galaxy: soft arms with a scatter of stars along them.
const spiral = (R: number, turns: number, count: number) => {
  let arms = '';
  const dots: { x: number; y: number; r: number; o: number }[] = [];
  for (const base of [0, Math.PI]) {
    for (let i = 0; i <= 36; i++) {
      const t = i / 36;
      const a = base + t * turns * Math.PI * 2;
      const r = R * (0.1 + 0.9 * t);
      arms += `${i ? 'L' : 'M'}${n(r * Math.cos(a))} ${n(r * Math.sin(a))}`;
    }
    for (let i = 0; i < count; i++) {
      const t = rand() ** 0.8;
      const a = base + t * turns * Math.PI * 2 + (rand() - 0.5) * 0.55;
      const r = R * (0.1 + 0.9 * t) + (rand() - 0.5) * R * 0.16;
      dots.push({ x: r * Math.cos(a), y: r * Math.sin(a), r: (0.35 + rand() * 0.75) * (1 - t * 0.45), o: 0.25 + (1 - t) * 0.65 });
    }
  }
  return { arms, dots };
};
const HUES = {
  blue: { arm: '#9fcfff', dot: '#e3f2ff', core: '#fff1d6' },
  rose: { arm: '#d3aeff', dot: '#f4e6ff', core: '#ffdcc6' },
};
const galaxies = [
  { x: 300, y: 250, R: 60, tilt: -24, flip: 1, squash: 0.44, hue: HUES.blue, spin: 150, ...spiral(60, 1.15, 46) },
  { x: 1150, y: 138, R: 40, tilt: 30, flip: -1, squash: 0.5, hue: HUES.rose, spin: 210, ...spiral(40, 1, 32) },
  { x: 735, y: 372, R: 27, tilt: -8, flip: 1, squash: 0.38, hue: HUES.blue, spin: 120, ...spiral(27, 0.9, 20) },
];

// Landscape, drawn in a 1600x300 box that is cropped from the sides and top.
const W = 1600;
const H = 300;
const RILEY_X = 790;
const FIRE_X = RILEY_X + 58;

type Ridge = (x: number) => number;
const far: Ridge = (x) => 170 - 20 * Math.sin(x / 310 + 2.1) - 12 * Math.sin(x / 127 + 5) - 5 * Math.sin(x / 49 + 1);
const back: Ridge = (x) => 198 - 18 * Math.sin(x / 240 + 0.3) - 9 * Math.sin(x / 95 + 3.3);
// Crests where Riley sits.
const mid: Ridge = (x) => 232 - 15 * Math.cos((x - RILEY_X - 20) / 190) - 5 * Math.sin(x / 83 + 1);
const front: Ridge = (x) => 270 - 12 * Math.sin(x / 205 + 1) - 6 * Math.sin(x / 88 + 2.2);

const ridge = (f: Ridge) => {
  let d = `M0 ${n(f(0))}`;
  for (let x = 16; x <= W; x += 16) d += `L${x} ${n(f(x))}`;
  return d;
};
const land = (f: Ridge) => `${ridge(f)}V${H}H0Z`;

// Glowing sprouts along the nearest dune.
const sprouts = Array.from({ length: 22 }, (_, i) => {
  const x = 40 + (i / 22) * 1520 + (rand() - 0.5) * 50;
  const y = front(x) + 2;
  const h = 9 + rand() * 13;
  const lean = (rand() - 0.5) * 7;
  return { x, y, h, lean, r: 1.3 + rand() * 1.3, delay: -rand() * 6, twin: rand() < 0.45 };
});

const embers = Array.from({ length: 7 }, (_, i) => ({
  dx: (rand() - 0.3) * 26,
  delay: -(i / 7) * 5.2,
  t: 4.6 + rand() * 1.6,
}));
---

<footer class="site-footer" data-footer>
  <div class="footer-sky" aria-hidden="true">
    <!-- Far away: faint stars, nebulae and slowly turning galaxies. -->
    <svg class="sky-layer far" viewBox={`0 0 ${TILE * 2} ${SKY_H}`} preserveAspectRatio="xMinYMin slice">
      <defs>
        <radialGradient id="sk-nebula-a">
          <stop offset="0" stop-color="#8a6cff" stop-opacity="0.2"></stop>
          <stop offset="1" stop-color="#8a6cff" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="sk-nebula-b">
          <stop offset="0" stop-color="#3fa7c9" stop-opacity="0.15"></stop>
          <stop offset="1" stop-color="#3fa7c9" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="sk-lens">
          <stop offset="0" stop-color="#fff3df" stop-opacity="0.85"></stop>
          <stop offset="0.25" stop-color="#bcd9ff" stop-opacity="0.35"></stop>
          <stop offset="1" stop-color="#bcd9ff" stop-opacity="0"></stop>
        </radialGradient>
        {
          galaxies.map((g, i) => (
            <>
              <radialGradient id={`sk-haze-${i}`}>
                <stop offset="0" stop-color={g.hue.arm} stop-opacity="0.3" />
                <stop offset="0.55" stop-color={g.hue.arm} stop-opacity="0.08" />
                <stop offset="1" stop-color={g.hue.arm} stop-opacity="0" />
              </radialGradient>
              <radialGradient id={`sk-arm-${i}`} gradientUnits="userSpaceOnUse" cx="0" cy="0" r={g.R}>
                <stop offset="0" stop-color={g.hue.arm} stop-opacity="0.6" />
                <stop offset="1" stop-color={g.hue.arm} stop-opacity="0" />
              </radialGradient>
              <radialGradient id={`sk-core-${i}`}>
                <stop offset="0" stop-color={g.hue.core} stop-opacity="0.95" />
                <stop offset="0.4" stop-color={g.hue.core} stop-opacity="0.35" />
                <stop offset="1" stop-color={g.hue.core} stop-opacity="0" />
              </radialGradient>
            </>
          ))
        }
      </defs>
      {
        [0, TILE].map((dx) => (
          <g>
            <ellipse cx={dx + 520} cy="210" rx="330" ry="150" fill="url(#sk-nebula-a)" transform={`rotate(-14 ${dx + 520} 210)`} />
            <ellipse cx={dx + 1240} cy="300" rx="280" ry="130" fill="url(#sk-nebula-b)" transform={`rotate(10 ${dx + 1240} 300)`} />
            {/* An edge-on galaxy, far off. */}
            <ellipse cx={dx + 1480} cy="262" rx="30" ry="5" fill="url(#sk-lens)" transform={`rotate(18 ${dx + 1480} 262)`} />
            {galaxies.map((g, i) => (
              <g transform={`translate(${dx + g.x} ${g.y}) rotate(${g.tilt}) scale(${g.flip} ${g.squash})`}>
                <circle r={n(g.R * 1.15)} fill={`url(#sk-haze-${i})`} />
                <g class="spin" style={`animation-duration:${g.spin}s`}>
                  <path d={g.arms} fill="none" stroke={`url(#sk-arm-${i})`} stroke-width={n(g.R * 0.2)} stroke-linecap="round" />
                  <path d={g.arms} fill="none" stroke={`url(#sk-arm-${i})`} stroke-width={n(g.R * 0.06)} stroke-linecap="round" />
                  {g.dots.map((d) => <circle cx={n(d.x)} cy={n(d.y)} r={d.r.toFixed(2)} fill={g.hue.dot} opacity={d.o.toFixed(2)} />)}
                </g>
                <circle r={n(g.R * 0.34)} fill={`url(#sk-core-${i})`} />
              </g>
            ))}
            {farStars.map((s) => (
              <circle
                class:list={['sstar', { tw: s.twinkle }]}
                cx={n(dx + s.x)}
                cy={n(s.y)}
                r={s.r.toFixed(2)}
                fill={s.fill}
                style={s.twinkle ? `--d:${s.d.toFixed(2)}s;--t:${s.t.toFixed(2)}s` : undefined}
              />
            ))}
          </g>
        ))
      }
    </svg>
    <!-- Closer stars slide by a little faster. -->
    <svg class="sky-layer near" viewBox={`0 0 ${TILE * 2} ${SKY_H}`} preserveAspectRatio="xMinYMin slice">
      {
        [0, TILE].map((dx) => (
          <g>
            {nearStars.map((s) => (
              <>
                {s.r > 1.45 && <circle cx={n(dx + s.x)} cy={n(s.y)} r={n(s.r * 3.4)} fill="#bcdcff" opacity="0.13" />}
                <circle
                  class:list={['sstar', { tw: s.twinkle }]}
                  cx={n(dx + s.x)}
                  cy={n(s.y)}
                  r={s.r.toFixed(2)}
                  fill={s.fill}
                  style={s.twinkle ? `--d:${s.d.toFixed(2)}s;--t:${s.t.toFixed(2)}s` : undefined}
                />
              </>
            ))}
          </g>
        ))
      }
    </svg>
    <span class="shooting" style="left:34%;top:9%;--d:-2s;--t:13s"></span>
    <span class="shooting" style="left:78%;top:22%;--d:-8.5s;--t:19s"></span>
  </div>

  <div class="footer-inner wrap">
    <div class="footer-about">
      <a class="footer-brand" href="/">Riley <span>the</span> Robot</a>
      <p>Written by Dustin Schau.</p>
      <p class="footer-fine">&copy; 2023 DSchau Publishing &middot; ISBN 979-8-9895683-0-7</p>
    </div>
    <ul class="footer-links">
      <li class="footer-read ico-host">
        <span class="footer-read-label" data-open-book="en"><Icon name="book" />Read the book</span>
        <button class="lang" data-open-book="en" aria-label="Read the book in English">en</button>
        <button class="lang" data-open-book="es" lang="es" aria-label="Leer el libro en español">es</button>
      </li>
      <li><a href="#author"><Icon name="pencil" />The author</a></li>
      <li><a href="https://github.com/DSchau/Riley-the-Robot"><Icon name="code" />GitHub</a></li>
    </ul>
    <p class="footer-fine footer-note">Illustrated with AI image models and edited in Photoshop.</p>
  </div>

  <svg class="footer-land" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <radialGradient id="ft-dusk" cx="0.5" cy="1" r="1" gradientTransform="translate(0 0.35) scale(1 0.65)">
        <stop offset="0" stop-color="#ff8a4d" stop-opacity="0.5"></stop>
        <stop offset="0.45" stop-color="#e06a6a" stop-opacity="0.16"></stop>
        <stop offset="1" stop-color="#7a5ad0" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="ft-fire">
        <stop offset="0" stop-color="#ffb070" stop-opacity="0.55"></stop>
        <stop offset="0.4" stop-color="#ff7a3d" stop-opacity="0.16"></stop>
        <stop offset="1" stop-color="#ff7a3d" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="ft-planet" cx="0.34" cy="0.3" r="0.85">
        <stop offset="0" stop-color="#ffe0bd"></stop>
        <stop offset="0.5" stop-color="#e9a183"></stop>
        <stop offset="1" stop-color="#6d4a86"></stop>
      </radialGradient>
      <linearGradient id="ft-far" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3b3a7c"></stop>
        <stop offset="0.6" stop-color="#232a66"></stop>
      </linearGradient>
      <linearGradient id="ft-back" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.3" stop-color="#262f6c"></stop>
        <stop offset="0.9" stop-color="#18204f"></stop>
      </linearGradient>
      <linearGradient id="ft-mid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.55" stop-color="#172250"></stop>
        <stop offset="1" stop-color="#0f1839"></stop>
      </linearGradient>
      <linearGradient id="ft-front" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.7" stop-color="#0d1634"></stop>
        <stop offset="1" stop-color="#070d22"></stop>
      </linearGradient>
      <clipPath id="ft-ring-front"><rect x="-60" y="0" width="120" height="30"></rect></clipPath>
    </defs>

    <!-- A ringed neighbour, hanging low. -->
    <g transform="translate(975 64)">
      <g class="planet">
        <ellipse rx="42" ry="9.5" transform="rotate(-16)" fill="none" stroke="#f6d8b8" stroke-opacity="0.4" stroke-width="2.6"></ellipse>
        <circle r="21" fill="url(#ft-planet)"></circle>
        <path d="M-20 -5q20 7 40 -3M-21 3q22 8 41 -1" fill="none" stroke="#fff3e0" stroke-opacity="0.22" stroke-width="2.4" stroke-linecap="round"></path>
        <g transform="rotate(-16)">
          <ellipse rx="42" ry="9.5" fill="none" stroke="#f6d8b8" stroke-opacity="0.75" stroke-width="2.6" clip-path="url(#ft-ring-front)"></ellipse>
        </g>
      </g>
    </g>

    <!-- The last of the sunset. -->
    <ellipse class="dusk" cx="960" cy="208" rx="700" ry="170" fill="url(#ft-dusk)"></ellipse>

    <path d={land(far)} fill="url(#ft-far)"></path>
    <path d={ridge(far)} fill="none" stroke="#ffb98a" stroke-opacity="0.32" stroke-width="1.4"></path>
    <path d={land(back)} fill="url(#ft-back)"></path>
    <path d={ridge(back)} fill="none" stroke="#ffb98a" stroke-opacity="0.14" stroke-width="1.2"></path>
    <path d={land(mid)} fill="url(#ft-mid)"></path>

    <!-- Campfire light on the dune. -->
    <ellipse class="firelight" cx={FIRE_X} cy={n(mid(FIRE_X) - 6)} rx="120" ry="52" fill="url(#ft-fire)"></ellipse>

    <!-- Riley, from behind, looking up. -->
    <g class="riley" data-x={RILEY_X} data-y={n(mid(RILEY_X) - 26)} transform={`translate(${RILEY_X} ${n(mid(RILEY_X) + 1.5)}) scale(1.15)`}>
      <ellipse cx="2" cy="0" rx="22" ry="3" fill="#060b1d" opacity="0.5"></ellipse>
      <g class="riley-arm">
        <path d="M-9 -14L-14 -2" stroke="#1d3652" stroke-width="5.5" stroke-linecap="round"></path>
        <circle cx="-14.5" cy="-1.5" r="3.2" fill="#2c5f74"></circle>
      </g>
      <path d="M9 -14L14 -2" stroke="#1d3652" stroke-width="5.5" stroke-linecap="round"></path>
      <circle cx="14.5" cy="-1.5" r="3.2" fill="#357085"></circle>
      <rect x="-9" y="-20" width="18" height="21" rx="6.5" fill="#223f5c"></rect>
      <path d="M8.6 -15v11" stroke="#ffb07a" stroke-opacity="0.75" stroke-width="1.1" stroke-linecap="round"></path>
      <g class="riley-head">
        <ellipse cx="-16.5" cy="-33" rx="3.2" ry="7.5" fill="#1b3350"></ellipse>
        <ellipse cx="16.5" cy="-33" rx="3.2" ry="7.5" fill="#1b3350"></ellipse>
        <ellipse class="ear-glow" cx="-19" cy="-33" rx="4" ry="6.5" fill="#59bdcb" opacity="0.28"></ellipse>
        <ellipse class="ear-glow" cx="19" cy="-33" rx="4" ry="6.5" fill="#59bdcb" opacity="0.28"></ellipse>
        <ellipse cx="-19" cy="-33" rx="1.3" ry="3.8" fill="#8fe3ee"></ellipse>
        <ellipse cx="19" cy="-33" rx="1.3" ry="3.8" fill="#8fe3ee"></ellipse>
        <rect x="-15.5" y="-46" width="31" height="26" rx="6.5" fill="#2a4e6c"></rect>
        <path d="M-15.5 -38.5h31M-5 -46v7.5" stroke="#1a3049" stroke-width="0.9" fill="none"></path>
        <path d="M15 -41v16" stroke="#ffb07a" stroke-opacity="0.8" stroke-width="1.2" stroke-linecap="round"></path>
      </g>
    </g>

    <!-- The campfire. -->
    <g transform={`translate(${FIRE_X} ${n(mid(FIRE_X) + 1)})`}>
      <g class="embers">
        {embers.map((e) => <circle class="ember" r="0.9" cy="-12" fill="#ffc48a" style={`--dx:${n(e.dx)}px;animation-delay:${e.delay.toFixed(2)}s;animation-duration:${e.t.toFixed(2)}s`} />)}
      </g>
      <path class="flame outer" d="M0 -2C-9 -5 -6.5 -15 -1 -23C0 -16 8 -14 6 -7C5 -4 3 -2 0 -2Z" fill="#ff7a3d"></path>
      <path class="flame inner" d="M0.5 -2C-4 -4 -3 -10 0.5 -14.5C2 -10.5 4.5 -8 3.5 -5C2.8 -3.2 1.5 -2 0.5 -2Z" fill="#ffd590"></path>
      <path d="M-9 -0.5L9 -4M-9 -4L9 -0.5" stroke="#2c1a12" stroke-width="3.6" stroke-linecap="round"></path>
    </g>

    <path d={land(front)} fill="url(#ft-front)"></path>

    <g class="sprouts" fill="none" stroke-linecap="round">
      {
        sprouts.map((s) => (
          <g class="push" data-x={n(s.x)} data-y={n(s.y)}>
          <g class="sprout" style={`animation-delay:${s.delay.toFixed(2)}s`}>
            <path d={`M${n(s.x)} ${n(s.y)}q${n(s.lean * 0.2)} ${n(-s.h * 0.6)} ${n(s.lean)} ${n(-s.h)}`} stroke="#2b5f78" stroke-width="1" />
            {s.twin && <path d={`M${n(s.x)} ${n(s.y)}q${n(-s.lean * 0.6 - 2)} ${n(-s.h * 0.35)} ${n(-s.lean - 4)} ${n(-s.h * 0.55)}`} stroke="#2b5f78" stroke-width="0.9" />}
            <circle class="bulb-halo" cx={n(s.x + s.lean)} cy={n(s.y - s.h)} r={n(s.r * 3)} fill="#7fd8ff" stroke="none" style={`animation-delay:${s.delay.toFixed(2)}s`} />
            <circle cx={n(s.x + s.lean)} cy={n(s.y - s.h)} r={n(s.r)} fill="#a5e6ff" stroke="none" />
          </g>
          </g>
        ))
      }
    </g>
  </svg>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer) {
    const sky = footer.querySelector<HTMLElement>('.footer-sky')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)');

    // Nothing animates while the footer is off screen.
    footer.classList.add('offscreen');
    new IntersectionObserver(([entry]) => footer.classList.toggle('offscreen', !entry.isIntersecting)).observe(footer);

    // Stars near the pointer burn a little brighter. The layers are always
    // sliding, so each star's place on screen is worked out from its layer.
    const layers = Array.from(footer.querySelectorAll<SVGSVGElement>('.sky-layer'), (svg) => ({
      svg,
      width: svg.viewBox.baseVal.width,
      stars: Array.from(svg.querySelectorAll<SVGCircleElement>('.sstar'), (el) => ({
        el,
        x: el.cx.baseVal.value,
        y: el.cy.baseVal.value,
        near: 0,
      })),
    }));
    const REACH = 120;
    let pointer: { x: number; y: number } | null = null;
    let queued = false;
    let again = 0;
    const light = () => {
      queued = false;
      for (const layer of layers) {
        const box = layer.svg.getBoundingClientRect();
        const k = box.width / layer.width;
        for (const star of layer.stars) {
          let near = 0;
          if (pointer) {
            const d = Math.hypot(box.left + star.x * k - pointer.x, box.top + star.y * k - pointer.y);
            near = d < REACH ? Math.round((1 - d / REACH) * 10) / 10 : 0;
          }
          if (near === star.near) continue;
          star.near = near;
          star.el.classList.toggle('near', near > 0);
          if (near) star.el.style.setProperty('--near', String(near));
          else star.el.style.removeProperty('--near');
        }
      }
      // Keep up with the drift while the pointer rests.
      clearTimeout(again);
      if (pointer) again = window.setTimeout(queue, 300);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(light);
      }
    };
    footer.addEventListener('pointermove', (ev) => {
      if (ev.pointerType === 'touch') return;
      pointer = { x: ev.clientX, y: ev.clientY };
      queue();
    });
    footer.addEventListener('pointerleave', () => {
      pointer = null;
      queue();
    });

    // A breeze crosses the dunes when the pointer arrives, the sprouts part
    // around it, and Riley waves when it comes close.
    const land = footer.querySelector<SVGSVGElement>('.footer-land')!;
    const meadow = land.querySelector<SVGGElement>('.sprouts')!;
    const riley = land.querySelector<SVGGElement>('.riley')!;
    const home = { x: Number(riley.dataset.x), y: Number(riley.dataset.y) };
    const sprouts = Array.from(land.querySelectorAll<SVGGElement>('.push'), (el) => ({
      el,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      pushed: false,
    }));
    const point = land.createSVGPoint();
    const PART = 130;
    let hello = 0;
    const greet = () => {
      if (hello || calm.matches) return;
      riley.classList.add('hi');
      hello = window.setTimeout(() => {
        riley.classList.remove('hi');
        hello = 0;
      }, 2400);
    };
    const locate = (ev: PointerEvent) => {
      const ctm = land.getScreenCTM();
      if (!ctm) return null;
      point.x = ev.clientX;
      point.y = ev.clientY;
      return point.matrixTransform(ctm.inverse());
    };
    let moved: PointerEvent | undefined;
    let parting = 0;
    footer.addEventListener('pointerenter', () => {
      if (calm.matches) return;
      meadow.classList.remove('gust');
      void meadow.getBBox(); // restart the animation
      meadow.classList.add('gust');
    });
    footer.addEventListener('pointermove', (ev) => {
      if (calm.matches || ev.pointerType === 'touch') return;
      moved = ev;
      parting ||= requestAnimationFrame(() => {
        parting = 0;
        const p = moved && locate(moved);
        if (!p) return;
        if (Math.hypot(p.x - home.x, p.y - home.y) < 70) greet();
        for (const sprout of sprouts) {
          const dx = sprout.x - p.x;
          const d = Math.hypot(dx, (sprout.y - p.y) * 0.6);
          if (d < PART) {
            const f = (1 - d / PART) ** 1.5;
            sprout.el.style.transform = `skewX(${(Math.sign(dx) * -f * 34).toFixed(1)}deg) scaleY(${(1 - f * 0.22).toFixed(2)})`;
            sprout.pushed = true;
          } else if (sprout.pushed) {
            sprout.el.style.transform = '';
            sprout.pushed = false;
          }
        }
      });
    });
    footer.addEventListener('pointerleave', () => {
      for (const sprout of sprouts) {
        sprout.el.style.transform = '';
        sprout.pushed = false;
      }
    });
    // A tap says hello too (touch has no hover).
    footer.addEventListener('pointerdown', (ev) => {
      const p = locate(ev);
      if (p && Math.hypot(p.x - home.x, p.y - home.y) < 90) greet();
    });

    // Tap the sky to make a wish.
    footer.addEventListener('click', (ev) => {
      if (calm.matches || (ev.target as HTMLElement).closest('a, button, [data-open-book]')) return;
      const box = sky.getBoundingClientRect();
      const wish = document.createElement('span');
      wish.className = 'shooting wish';
      wish.style.left = `${ev.clientX - box.left}px`;
      wish.style.top = `${ev.clientY - box.top}px`;
      wish.addEventListener('animationend', () => wish.remove());
      sky.append(wish);
    });
  }
</script>

