---
import Layout from '../layouts/Layout.astro';
import Riley from '../components/Riley.astro';
---

<Layout title="Lost in space — Riley the Robot">
  <main class="lost">
    <!-- Fast asleep until someone comes close. -->
    <div class="lost-riley">
      <Riley mood="sleep" tap="wave" fallback="/art/riley-wave.webp" label="Riley the Robot, fast asleep" />
    </div>
    <h1>This page drifted off to sleep.</h1>
    <p>Days became months, months became years… and it never came back.</p>
    <a class="btn" href="/">Back to Riley</a>
  </main>
</Layout>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    padding: 48px var(--gutter);
    text-align: center;
  }
  .lost-riley {
    width: 240px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  p {
    color: var(--ink-soft);
  }
</style>
